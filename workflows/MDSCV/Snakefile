#################################################################
# AML‑VAE • Cross‑validated workflow
#################################################################
import datetime, pathlib, textwrap, shlex 
from textwrap import dedent

configfile: "config.yaml"

# ----------------------------------------------------------------
# Config shortcuts
# ----------------------------------------------------------------
run_id   = config["run_id"]
DATA_DIR = config["data_dir"]

SCRIPTS  = config["scripts"]
PARTCFG  = config["partition"]
TRAINCFG = config["train"]

K       = int(PARTCFG["k"])
FOLDS   = range(K)
FOLDDIR = PARTCFG["out_dir"] + f"/{run_id}"

DATASET_NAME = PARTCFG["dataset_name"]



# Helpers to keep path building tidy -----------------------------------------
def fdir(fold):               # ../folds/fold_*
    return FOLDDIR / f"fold_{fold}"

def wdir(wc):                 # ../runs/<run_id>/fold_*
    return pathlib.Path(f"../runs/{run_id}") / f"fold_{wc.fold}"

def proc_out(wc):             # …/proc
    return wdir(wc) / "proc"

def train_out(wc):            # …/train
    return wdir(wc) / "train"

# ----------------------------------------------------------------
# Rule: all – final targets are the trained models for every fold
# ----------------------------------------------------------------
rule all:
    input:
        [f"{FOLDDIR}/fold_{i}/train/model.pt" for i in FOLDS],
        [f"{FOLDDIR}/fold_{i}/eval/eval.csv" for i in FOLDS],
        [f"{FOLDDIR}/fold_{i}/clustering/vae_cluster_assignments.csv" for i in FOLDS],
        [f"{FOLDDIR}/fold_{i}/clustering/pca_cluster_assignments.csv" for i in FOLDS],
        f"{FOLDDIR}/consensus/vae_consensus_matrix.csv",
        f"{FOLDDIR}/consensus/pca_consensus_matrix.csv",
        f"{FOLDDIR}/consensus_heatmap/vae_consensus_heatmap_complete.txt",
        f"{FOLDDIR}/consensus_heatmap/pca_consensus_heatmap_complete.txt",
#        [f"../runs/{run_id}/fold_{i}/viz/clin_viz_complete.txt" for i in FOLDS],

#################################################################
# 1.  Generate K‑fold partitions (runs once, then cached)
#################################################################
proc_csvs = expand("{out}/fold_{i}/proc/{dataset_name}_expr.csv",      
                    out=FOLDDIR, i=FOLDS, dataset_name=DATASET_NAME)

rule make_partitions:
    output:
        proc_csvs = proc_csvs
    params:
        script = SCRIPTS["partition"],
        fpath   = PARTCFG["fpath"],
        out    = FOLDDIR,
        k      = PARTCFG["k"],
        seed   = PARTCFG["seed"],
        n_val  = PARTCFG["n_val"],
        idcol  = PARTCFG["id_type_name"],
        target_name = PARTCFG["target_name"],
        counts_name = PARTCFG["counts_name"],
        gene_col = PARTCFG["gene_col"],
        id_col = PARTCFG["id_col"],
        dataset_name = PARTCFG["dataset_name"],
        gene_selection_method = PARTCFG["gene_selection_method"],
        num_top_genes = PARTCFG["num_top_genes"],
        norm_method = PARTCFG["norm_method"],
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        python {params.script} \
            --fpath {params.fpath} \
            --out {params.out} \
            --k {params.k} \
            --seed {params.seed} \
            --n_val {params.n_val} \
            --id_type_name {params.idcol} \
            --target_name {params.target_name} \
            --counts_name {params.counts_name} \
            --gene_col {params.gene_col} \
            --id_col {params.id_col} \
            --dataset_name {params.dataset_name} \
            --gene_selection_method {params.gene_selection_method} \
            --num_top_genes {params.num_top_genes} \
            --norm_method {params.norm_method}
        """

#################################################################
# 3.  Train AML‑VAE per fold
#################################################################

rule train:
    input:
        proc_csv = f"{FOLDDIR}/fold_{{fold}}/proc/{DATASET_NAME}_expr.csv"
    output:
        model = f"{FOLDDIR}/fold_{{fold}}/train/model.pt"
    params:
        fold = lambda wc: wc.fold,
        script    = SCRIPTS["train"],
        proc_dir  = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/proc/",
        train_dir = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/train/",
        # -- the rest of the hyper‑params exactly as before --
        epochs    = TRAINCFG["epochs"],
        patience  = TRAINCFG["patience"],
        n_hidden  = TRAINCFG["n_hidden"],
        n_latent  = TRAINCFG["n_latent"],
        n_layers  = TRAINCFG["n_layers"],
        norm      = TRAINCFG["norm"],
        anneal    = TRAINCFG["anneal"],
        dropout   = TRAINCFG["dropout"],
        nonlin    = TRAINCFG["nonlin"],
        lr        = TRAINCFG["lr"],
        l2        = TRAINCFG["l2"],
        norm_first = TRAINCFG["norm_first"],
        beta      = TRAINCFG["beta"],
        batch_size = TRAINCFG["batch_size"],
        dsname    = PARTCFG["dataset_name"],
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.train_dir}
        python {params.script} \
            --data {DATA_DIR} \
            --proc {params.proc_dir} \
            --out  {params.train_dir} \
            --dataset_name {params.dsname} \
            --epochs {params.epochs} \
            --patience {params.patience} \
            --n_hidden {params.n_hidden} \
            --n_latent {params.n_latent} \
            --n_layers {params.n_layers} \
            --norm {params.norm} \
            --norm_first {params.norm_first} \
            --anneal {params.anneal} \
            --dropout {params.dropout} \
            --nonlin {params.nonlin} \
            --lr {params.lr} \
            --l2 {params.l2} \
            --beta {params.beta} \
            --batch_size {params.batch_size} 
        """

#################################################################
# 4.  Evaluate each trained model
#################################################################
rule evaluate:
    input:
        model = rules.train.output.model,
    output:
        csv = f"{FOLDDIR}/fold_{{fold}}/eval/eval.csv"
    params:
        script    = SCRIPTS["eval"],
        proc_dir  = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/proc",
        out_dir   = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/eval",
        data_dir  = DATA_DIR,                        
        dataset   = DATASET_NAME,
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --data {params.data_dir} \
            --proc {params.proc_dir} \
            --out  {params.out_dir} \
            --model_path {input.model} \
            --dataset {params.dataset} \
        """

#################################################################
# 5.  Cluster VAE latent space
#################################################################
rule cluster_vae:
    input:
        eval_csv = rules.evaluate.output.csv,
    output:
        clusters = f"{FOLDDIR}/fold_{{fold}}/clustering/vae_cluster_assignments.csv",
        metrics = f"{FOLDDIR}/fold_{{fold}}/clustering/vae_cluster_metrics.csv"
    params:
        script    = SCRIPTS["consensus_clustering"],
        latent_csv = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/eval/{DATASET_NAME}_vae_z.csv",
        out_dir   = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/clustering",
        k         = config["clustering"]["k"],
        resolution = config["clustering"]["resolution"],
        seed      = lambda wc: int(config["clustering"]["seed"]) + int(wc.fold),
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --latent_csv {params.latent_csv} \
            --out {output.clusters} \
            --out_metrics {output.metrics} \
            --k {params.k} \
            --resolution {params.resolution} \
            --seed {params.seed}
        """

#################################################################
# 6.  Cluster PCA latent space
#################################################################
rule cluster_pca:
    input:
        eval_csv = rules.evaluate.output.csv,
    output:
        clusters = f"{FOLDDIR}/fold_{{fold}}/clustering/pca_cluster_assignments.csv",
        metrics = f"{FOLDDIR}/fold_{{fold}}/clustering/pca_cluster_metrics.csv"
    params:
        script    = SCRIPTS["consensus_clustering"],
        latent_csv = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/eval/{DATASET_NAME}_pca_z.csv",
        out_dir   = lambda wc: f"{FOLDDIR}/fold_{wc.fold}/clustering",
        k         = config["clustering"]["k"],
        resolution = config["clustering"]["resolution"],
        seed      = lambda wc: int(config["clustering"]["seed"]) + int(wc.fold),
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --latent_csv {params.latent_csv} \
            --out {output.clusters} \
            --out_metrics {output.metrics} \
            --k {params.k} \
            --resolution {params.resolution} \
            --seed {params.seed}
        """

#################################################################
# 7.  Aggregate VAE consensus matrix across folds
#################################################################
rule aggregate_vae_consensus:
    input:
        clusters = [f"{FOLDDIR}/fold_{i}/clustering/vae_cluster_assignments.csv" for i in FOLDS]
    output:
        consensus = f"{FOLDDIR}/consensus/vae_consensus_matrix.csv"
    params:
        script = SCRIPTS["aggregate_consensus"],
        out_dir = f"{FOLDDIR}/consensus"
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --cluster_files {input.clusters} \
            --out {output.consensus}
        """

#################################################################
# 8.  Aggregate PCA consensus matrix across folds
#################################################################
rule aggregate_pca_consensus:
    input:
        clusters = [f"{FOLDDIR}/fold_{i}/clustering/pca_cluster_assignments.csv" for i in FOLDS]
    output:
        consensus = f"{FOLDDIR}/consensus/pca_consensus_matrix.csv"
    params:
        script = SCRIPTS["aggregate_consensus"],
        out_dir = f"{FOLDDIR}/consensus"
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --cluster_files {input.clusters} \
            --out {output.consensus}
        """

#################################################################
# 9.  Create VAE consensus heatmap with clinical annotations
#################################################################
CONSHEAT = config["consensus_heatmap"]

rule heatmap_vae_consensus:
    input:
        consensus = rules.aggregate_vae_consensus.output.consensus
    output:
        complete = f"{FOLDDIR}/consensus_heatmap/vae_consensus_heatmap_complete.txt"
    params:
        script = SCRIPTS["consensus_heatmap"],
        out_dir = f"{FOLDDIR}/consensus_heatmap",
        clin_path = CONSHEAT["clin_path"],
        id_col = CONSHEAT["id_col"],
        linkage_method = CONSHEAT["linkage_method"],
        figsize = CONSHEAT["figsize"],
        clin_vars = "<::>".join(CONSHEAT["clin_vars"])
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --consensus_matrix_path {input.consensus} \
            --clin_path {params.clin_path} \
            --out {params.out_dir} \
            --prefix vae_ \
            --id_col {params.id_col} \
            --linkage_method {params.linkage_method} \
            --figsize {params.figsize} \
            --clin_vars "{params.clin_vars}"
        """

#################################################################
# 10. Create PCA consensus heatmap with clinical annotations
#################################################################
rule heatmap_pca_consensus:
    input:
        consensus = rules.aggregate_pca_consensus.output.consensus
    output:
        complete = f"{FOLDDIR}/consensus_heatmap/pca_consensus_heatmap_complete.txt"
    params:
        script = SCRIPTS["consensus_heatmap"],
        out_dir = f"{FOLDDIR}/consensus_heatmap",
        clin_path = CONSHEAT["clin_path"],
        id_col = CONSHEAT["id_col"],
        linkage_method = CONSHEAT["linkage_method"],
        figsize = CONSHEAT["figsize"],
        clin_vars = "<::>".join(CONSHEAT["clin_vars"])
    conda:
        "../envs/amlvae.yaml"
    shell:
        """
        mkdir -p {params.out_dir}
        python {params.script} \
            --consensus_matrix_path {input.consensus} \
            --clin_path {params.clin_path} \
            --out {params.out_dir} \
            --prefix pca_ \
            --id_col {params.id_col} \
            --linkage_method {params.linkage_method} \
            --figsize {params.figsize} \
            --clin_vars "{params.clin_vars}"
        """